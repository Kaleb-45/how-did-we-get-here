[gd_resource type="Theme" format=3]

; game_theme.tres
; The look of every 2D screen, in ONE place: text sizes AND colors.
; Set as the project's theme in Project Settings > GUI > Theme > Custom.
;
; COLORS (navy and orange):
;   screen background  navy        #0a1633
;   panels             lighter navy #13244a, orange border
;   accent             orange      #ff9933  (titles, small headings, main buttons)
;   text               white / light blue-gray
; Green, yellow and red are NOT here: they mean safe / close / over the
; limit, so they stay in game_data.json ("dashboard.colors").
;
; Text styles ("type variations"). A label picks one with its
; Theme Type Variation property, for example  theme_type_variation = &"BodyText"
;   TitleText    big screen titles (orange)              50
;   HeadingText  card titles, part names                 34
;   BodyText     story, inner voice, tables              28
;   SmallText    hints (gray-blue)                       24
;   AccentText   small headings (orange)                 24
;   TableText    the dashboard rows                      22
;   BannerText   the POWER LOW alarm                     46
;   SubtitleSpeaker  the amber speaker name in the cutscene subtitles  22
;   SubtitleLine     the white subtitle words in the cutscene          26
;   SubtitlePanel    the rounded, slightly see-through navy box behind the subtitles
; Timed press (the closing ring), type name TimedPress, read with get_theme_color:
;   ring_color, target_color, perfect_zone_color, good_zone_color, backdrop_color
; Launch side view (plain gray rectangles), type name RocketView:
;   sky_color, ground_color, body_color, nose_color, fin_color, flame_color, stage_line_color
; Boxes and buttons:
;   ScreenBackground  the navy background of a screen (a Panel)
;   NavyPanel         cards, the dashboard, the review table
;   VoiceBar          the inner voice bar at the bottom
;   Button            (no style needed) main buttons: orange with navy text
;   SmallButton       the part version buttons: navy, orange when picked
; Anything with no style uses default_font_size: 26.

[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.04, 0.086, 0.2, 1)


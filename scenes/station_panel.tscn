[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/station_panel.gd" id="1_panel"]

[node name="StationPanel" type="PanelContainer"]
custom_minimum_size = Vector2(760, 0)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -380.0
offset_top = -220.0
offset_right = 380.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 1
theme_type_variation = &"NavyPanel"
script = ExtResource("1_panel")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopRow" type="HBoxContainer" parent="Column"]
layout_mode = 2

[node name="Title" type="Label" parent="Column/TopRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingText"
text = "STATION"

[node name="CloseHint" type="Label" parent="Column/TopRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"SmallText"
text = "E or Esc = close"

[node name="Body" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyText"
text = "What this station does."
autowrap_mode = 3

[node name="ActionButton" type="Button" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Do it"

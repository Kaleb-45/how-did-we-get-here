[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/build.gd" id="1_build"]
[ext_resource type="PackedScene" path="res://scenes/dashboard.tscn" id="2_dash"]

[node name="Build" type="Control"]
layout_mode = 3

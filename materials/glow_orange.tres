[gd_resource type="StandardMaterial3D" format=3]

; glow_orange.tres
; Glow: orange. Small orange lights. Lower emission_energy_multiplier to make it dimmer.
; To change the colour: click this file, then change Albedo > Color. Hex: #FF9933
; All library materials are matte: roughness 0.9, metallic 0, specular 0.2.

[resource]
albedo_color = Color(1.0000, 0.6000, 0.2000, 1)
metallic_specular = 0.2
roughness = 0.9
emission_enabled = true
emission = Color(1.0000, 0.6000, 0.2000, 1)
emission_energy_multiplier = 1.0

[gd_resource type="StandardMaterial3D" format=3]

; glow_cyan.tres
; Glow: cyan. Screens and console lights (the only things that bloom). Lower emission_energy_multiplier to make it dimmer.
; To change the colour: click this file, then change Albedo > Color. Hex: #4FD1D9
; All library materials are matte: roughness 0.9, metallic 0, specular 0.2.

[resource]
albedo_color = Color(0.3098, 0.8196, 0.8510, 1)
metallic_specular = 0.2
roughness = 0.9
emission_enabled = true
emission = Color(0.3098, 0.8196, 0.8510, 1)
emission_energy_multiplier = 0.9

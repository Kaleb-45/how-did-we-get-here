[node name="Used" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyText"
text = "Power used: 0 W of 0 W"

[node name="UsedBar" type="ProgressBar" parent="Column"]
unique_name_in_owner = true
